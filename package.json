{
  "name": "ecommerce-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,green \"npm:server\" \"npm:web\"",
    "dev:short": "concurrently -k -n API,WEB -c cyan,green \"npm:server:short\" \"npm:web\"",
    "web": "vite",
    "server": "node server/server.js",
    "server:short": "node server/server.js --ttl=30s",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --no-deprecation node_modules/jest/bin/jest.js",
    "test:watch": "node --no-deprecation node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --no-deprecation node_modules/jest/bin/jest.js --coverage",
    "test:report": "node --no-deprecation node_modules/jest/bin/jest.js --verbose"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@reduxjs/toolkit": "^2.2.5",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "json-server": "0.17.4",
    "jsonwebtoken": "^9.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.23.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@testing-library/dom": "^9.3.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "babel-jest": "^29.7.0",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.0"
  }
}